/* FAMILYMAP: the NL curves of the family in (E,t), E = e^2 (sources: build/REPORT-BUILD1, math/REPORT-MATH1, this seat) */
NL1(E,t) = E*(t-1)^2 - 2*(t+2)*(3*t+1)^2;
NLA(E,t) = (t+2)*(73*t+98)*E^2 - 8*(27*t^3+237*t^2+416*t+196)*E + 16*(9*t^2+21*t+14)^2;
NLB(E,t) = 21097*E^2*t^4+80104*E^2*t^3+157848*E^2*t^2+33952*E^2*t+1936*E^2-73368*E*t^5-486792*E*t^4-1211264*E*t^3-1129920*E*t^2-11904*E*t-15488*E+63504*t^6+598752*t^5+2120976*t^4+3256704*t^3+1564288*t^2-495616*t+30976;
FA(E,t) = 9*E*(11*t+6)*(t+2) - 4*(t+3)*(7*t+6)^2;
X2(E,t) = 73*E^2*t^2+86*E^2*t+49*E^2-324*E*t^3-912*E*t^2-932*E*t-392*E+324*t^4+1512*t^3+2772*t^2+2352*t+784;
SM(E,t) = E*(1+t) - 4;
LA(E,t) = E*(1-t) - 4;
LE(E,t) = 17*E^2*t+2*E^2-88*E*t^2-120*E*t-16*E+144*t^3+384*t^2+208*t+32;
DISC(E,t) = t*(t+1)*(t+2)*(t+3)*(E-2*t-4)*(3*E-4*t-12)*(E-4*t-4);
CURVES = [NL1, NLA, NLB, FA, X2, SM, LA, LE];
CNAMES = ["NL1","NL_A","NL_B","F_a","X2","S","L_a","L_e"];
